{
  "name": "daybyday",
  "productName": "DayByDay",
  "version": "1.0.0",
  "private": true,
  "description": "A local desktop planner for daily tasks, schedules, and semester courses",
  "keywords": [],
  "license": "MIT",
  "author": "lan",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "rebuild:native": "electron-rebuild --force --which-module better-sqlite3",
    "prepare:sqlite": "node scripts/prepare-native-resources.mjs",
    "package": "node scripts/prepare-native-resources.mjs && electron-forge package",
    "make": "node scripts/prepare-native-resources.mjs && electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:electron-sqlite": "node scripts/test-electron-sqlite.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-base": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.2.1",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-squirrel-startup": "^1.0.1",
    "exceljs": "^4.4.0",
    "ical.js": "^2.2.1",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "7.0.0"
  }
}
